{
  "name": "smarthr-backend",
  "version": "1.0.0",
  "description": "SmartHR Authentication Backend - AI Resume Screening Platform",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.development -- tsx watch src/server.ts --env=development",
    "start": "dotenv -e .env.production -- tsx src/server.ts --env=production",
    "start:staging": "dotenv -e .env.staging -- tsx src/server.ts --env=staging",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/services/rankingService.test.ts src/services/jobService.trends.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env.development -- prisma migrate dev",
    "prisma:push": "dotenv -e .env.development -- prisma db push",
    "prisma:studio": "dotenv -e .env.development -- prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "smarthr",
    "authentication",
    "jwt",
    "postgresql",
    "prisma"
  ],
  "author": "SmartHR Team",
  "license": "MIT"
}
